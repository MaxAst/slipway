{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "clean": "rm -rf dist .turbo node_modules",
    "dev": "dotenv -- pnpm run --stream \"/dev:/\"",
    "dev:tsc": "tsc --watch --preserveWatchOutput",
    "dev:node": "node --enable-source-maps --watch dist/server.js"
  },
  "dependencies": {
    "@effect/platform-node": "0.91.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.0.1",
    "@fastify/helmet": "13.0.1",
    "@fastify/session": "11.1.0",
    "@fastify/swagger": "9.5.1",
    "@google-cloud/pubsub": "5.1.0",
    "@my/api": "workspace:*",
    "@my/db": "workspace:*",
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@scalar/fastify-api-reference": "1.32.9",
    "@trpc/server": "11.4.3",
    "arctic": "3.7.0",
    "effect": "3.16.16",
    "fastify": "5.4.0",
    "pino-pretty": "13.0.0"
  },
  "devDependencies": {
    "@my/typescript-config": "workspace:*",
    "dotenv-cli": "~8.0.0"
  }
}
