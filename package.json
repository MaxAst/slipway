{
  "name": "slipway",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest",
    "build": "turbo build",
    "clean": "turbo run clean && rm -rf node_modules .turbo && rm pnpm-lock.yaml",
    "clean:lite": "turbo run clean && rm -rf .turbo",
    "clean:tsbuildinfo": "find . -name 'tsconfig.tsbuildinfo' -type f -delete",
    "db:generate": "pnpm --filter @my/db run migration:generate",
    "db:migrate": "pnpm --filter @my/db run migration:run",
    "db:seed": "pnpm --filter @my/db run seed",
    "deps:cleanup-all": "pnpm run deps:delete-nested && pnpm install",
    "deps:delete-nested": "rm -rf packages/**/node_modules apps/**/node_modules",
    "deps:fix-mismatches": "syncpack fix-mismatches",
    "deps:set-ranges": "syncpack set-semver-ranges",
    "deps:update": "syncpack update && pnpm run deps:fix-mismatches && pnpm install",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "frontend": "turbo run dev --filter=frontend",
    "type-check": "turbo run type-check",
    "server:build": "turbo run build --filter=server...",
    "server:dev": "turbo run dev --filter=server...",
    "worker:build": "turbo run build --filter=worker...",
    "worker:dev": "turbo run dev --filter=worker...",
    "cms:build": "turbo run build --filter=cms...",
    "cms:dev": "turbo run dev --filter=cms...",
    "frontend:build-deps": "turbo run build --filter=frontend^..."
  },
  "devDependencies": {
    "@biomejs/biome": "~2.1.2",
    "husky": "~9.1.7",
    "lint-staged": "~16.1.2",
    "syncpack": "~13.0.3",
    "turbo": "~2.5.2",
    "typescript": "~5.8.3",
    "vite": "~7.0.0",
    "vitest": "~3.2.4"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "pnpm run format-and-lint:fix"
    ]
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
